{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-guard-gate.py\"",
            "timeout": 10,
            "statusMessage": "limit-guard: checking usage window"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "quota_auto_resume_fired|quota_auto_resume_stale|quota_auto_resume_disabled",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-guard-gate.py\" --notification",
            "timeout": 10
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "rate_limit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/limit-guard-gate.py\" --notification",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
